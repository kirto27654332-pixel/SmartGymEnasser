# Copiez ce fichier vers `.env` et remplissez les valeurs.
# `.env` est versionné sur Git → Vercel lit ce fichier au build (pas de config manuelle).
# `.env.local` reste optionnel pour overrides locaux (gitignored via *.local).

# EmailJS
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_EMAILJS_SERVICE_ID=service_8xe9u7l
VITE_EMAILJS_TEMPLATE_ID=template_wvml0jc

# Firebase — https://console.firebase.google.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — Dashboard → Account Details → Cloud name
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=smart-gym-upload

# Admin email autorisé
VITE_ADMIN_EMAIL=your@email.com
